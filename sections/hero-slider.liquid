<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
<section class="hero-swiper-section">
  <div class="swiper heroSwiper">
    <div class="swiper-wrapper">
        {% for block in section.blocks %}
            <div class="swiper-slide hero-slide">
                <div class="hero-media left">
                    {% if block.settings.left_video != blank %}
                        {% if block.settings.link_left != blank %}
                            <a href="{{ block.settings.link_left }}" class="hero-left-link">
                        {% endif %}
                        {{- '<!-- Preload left video sources -->' }}
                        {%- for source in block.settings.left_video.sources -%}
                        {%- if source.mime_type == 'video/webm' -%}
                            <link rel="preload" as="video" href="{{ source.url }}" type="video/webm" fetchpriority="high">
                        {%- elsif source.mime_type == 'video/mp4' -%}
                            <link rel="preload" as="video" href="{{ source.url }}" type="video/mp4" fetchpriority="high">
                        {%- endif -%}
                        {%- endfor -%}

                        {%- assign left_poster = block.settings.left_video.preview_image | image_url: width: 1920 -%}
                        <video
                            autoplay
                            muted
                            loop
                            playsinline
                            preload="auto"
                            fetchpriority="high"
                            poster="{{ left_poster }}"
                            aria-label="{{ block.settings.left_video.alt | default: block.settings.heading | escape }}"
                            >
                            {%- for source in block.settings.left_video.sources -%}
                                {%- if source.mime_type == 'video/webm' -%}
                                <source src="{{ source.url }}" type="video/webm">
                                {%- endif -%}
                            {%- endfor -%}
                            {%- for source in block.settings.left_video.sources -%}
                                {%- if source.mime_type == 'video/mp4' -%}
                                <source src="{{ source.url }}" type="video/mp4">
                                {%- endif -%}
                            {%- endfor -%}
                        </video>
                        {% if block.settings.link_left != blank %}
                            </a>
                        {% endif %}
                    {% elsif block.settings.left_image != blank %}
                            {% if block.settings.link_left != blank %}
                                <a href="{{ block.settings.link_left }}" class="hero-left-link">
                            {% endif %}
                                <img
                                src="{{ block.settings.left_image | image_url }}"
                                alt="{{ block.settings.left_image.alt | default: block.settings.heading | escape }}"
                                loading="lazy"
                                height=""
                                width=""
                                >
                            {% if block.settings.link_left != blank %}
                            </a>
                        {% endif %}
                    {% endif %}
                </div>
                <!-- CONTENT -->
                <div class="hero-content">
                <div class="hero-content-text">
                    {% if block.settings.subheading != blank %}
                    <p class="subheading">{{ block.settings.subheading }}</p>
                    {% endif %}
                    {% if block.settings.heading != blank %}
                    <h2>{{ block.settings.heading }}</h2>
                    {% endif %}
                    {% if block.settings.button_label != blank %}
                    <a href="{{ block.settings.button_link }}" class="hero-btn">
                        {{ block.settings.button_label }}
                    </a>
                    {% endif %}
                </div>
                </div>
                <!-- RIGHT -->
                <div class="hero-media right">
                {% if block.settings.right_video != blank %}
                    {% if block.settings.link_right != blank %}
                        <a href="{{ block.settings.link_right }}" class="hero-left-right">
                    {% endif %}
                        {{- '<!-- Preload right video sources -->' }}
                        {%- for source in block.settings.right_video.sources -%}
                        {%- if source.mime_type == 'video/webm' -%}
                            <link rel="preload" as="video" href="{{ source.url }}" type="video/webm" fetchpriority="high">
                        {%- elsif source.mime_type == 'video/mp4' -%}
                            <link rel="preload" as="video" href="{{ source.url }}" type="video/mp4" fetchpriority="high">
                        {%- endif -%}
                        {%- endfor -%}
                        {%- assign right_poster = block.settings.right_video.preview_image | image_url: width: 1920 -%}
                        <video
                            autoplay
                            muted
                            loop
                            playsinline
                            preload="auto"
                            fetchpriority="high"
                            poster="{{ right_poster }}"
                            aria-label="{{ block.settings.right_video.alt | default: block.settings.heading | escape }}"
                            >
                            {%- for source in block.settings.right_video.sources -%}
                                {%- if source.mime_type == 'video/webm' -%}
                                <source src="{{ source.url }}" type="video/webm">
                                {%- endif -%}
                            {%- endfor -%}
                            {%- for source in block.settings.right_video.sources -%}
                                {%- if source.mime_type == 'video/mp4' -%}
                                <source src="{{ source.url }}" type="video/mp4">
                                {%- endif -%}
                            {%- endfor -%}
                        </video>
                    {% if block.settings.link_right != blank %}
                        </a>
                    {% endif %}
                {% elsif block.settings.right_image != blank %}
                    {% if block.settings.link_right != blank %}
                        <a href="{{ block.settings.link_right }}" class="hero-left-right">
                    {% endif %}
                    <img
                    src="{{ block.settings.right_image | image_url }}"
                    alt="{{ block.settings.right_image.alt | default: block.settings.heading | escape }}"
                    loading="lazy"
                    height=""
                    width=""
                    >
                    {% if block.settings.link_right != blank %}
                        </a>
                    {% endif %}
                {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
    <!-- NAV -->
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
    <div class="swiper-pagination"></div>

  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.heroSwiper', {
        loop: true,
        speed: 800,
        pagination: {
        el: '.swiper-pagination',
        clickable: true
        },
        navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev'
        }
    });
    });
</script>

<style>
    .hero-swiper-section {
        .hero-slide {
            display: flex;
            background: #fff;
            @media(max-width: 767px) {
                flex-wrap: wrap;
            }
            .hero-media.left, .hero-media.right {
                width:35%;
                line-height:0;
                position: relative;
                padding-bottom:45%;
                @media(max-width: 767px) {
                    order:1;
                    width:50%;
                    padding-bottom:94%;
                }
                img, video {
                    position: absolute;
                    inset: 0;
                    object-fit: cover;
                    width: 100%;
                    height: 100%;
                } 
            }
            .hero-content {
                width:30%;
                text-align: center;
                padding: 30px 20px;
                display: flex;
                justify-content: center;
                align-items: center;
                @media(max-width: 767px) {
                    order:3;
                    width:100%
                }
            }
        }
        /* MEDIA */
        .hero-media-wrap {
        display: flex;
        }
        .hero-content .subheading {
        font-size: 14px;
        color: #777;
        margin-bottom: 10px;
        }

        .hero-content h2 {
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 20px;
        }

        .hero-btn {
        display: inline-block;
        padding: 12px 22px;
        background: #c8f05a;
        border-radius: 25px;
        text-decoration: none;
        color: #000;
        font-weight: 500;
        }

        /* DESKTOP */
        @media(min-width: 768px) {
        .hero-media-wrap {
            width: 66.66%;
            height: 500px;
        }

        .hero-content {
            width: 33.33%;
            padding: 60px;
        }

        .hero-content h2 {
            font-size: 32px;
        }
        }
        /* SWIPER */
        .swiper-button-prev,
        .swiper-button-next {
            color: #000;
            position: absolute;
            transform: translateY(-50%)

        }
        .swiper-button-prev{
            left: 20px;
        }
        .swiper-button-next{
            right: 20px;
        }
        .swiper-pagination-bullet {
            background: #000;
        }
    }
    {% comment %} @keyframes swipeLeft {
        0%{transform:translateX(0%)}
        50%{transform:translateX(-40%)}
        60%{transform:translateX(-40%)}
        100%{transform:translateX(0%)}
    }
    #collectionmodalcontainer .product-list__inner > .product-item:first-child .product-item__image-wrapper .image-slider .image-inner img.first-image{
        animation: swipeLeft 3s ease-out 2 2s;
    } {% endcomment %}
</style>

{% schema %}
    {
    "name": "Hero Video Banner",
    "tag": "section",
    "class": "hero-swiper",
    "blocks": [
        {
        "type": "slide",
        "name": "Slide",
        "settings": [

            {
            "type": "image_picker",
            "id": "left_image",
            "label": "Left Image"
            },
            {
            "type": "video",
            "id": "left_video",
            "label": "Left Video"
            },
            {
                "type": "url",
                "id": "link_left",
                "label": "Link Left"
            },
            {
            "type": "image_picker",
            "id": "right_image",
            "label": "Right Image"
            },
            {
            "type": "video",
            "id": "right_video",
            "label": "Right Video"
            },
            {
                "type": "url",
                "id": "right_left",
                "label": "Link Right"
            },

            {
            "type": "text",
            "id": "subheading",
            "label": "Subheading",
            "default": "Timeless elegance"
            },
            {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Where Tradition Meets Modern Style"
            },

            {
            "type": "text",
            "id": "button_label",
            "label": "Button Label",
            "default": "Shop Now"
            },
            {
            "type": "url",
            "id": "button_link",
            "label": "Button Link"
            }
        ]
        }
    ],
    "presets": [
        {
        "name": "Hero Video Banner",
        "blocks": [
            { "type": "slide" },
            { "type": "slide" }
        ]
        }
    ]
    }
{% endschema %}
